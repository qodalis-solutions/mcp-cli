# Copy to .env and edit. Used with: npm run dev -- --env-file .env
# Leave QCLI_URL unset for developer mode (only the qcli_* plugin-development tools).
QCLI_URL=http://localhost:8047

# Either an API token (token create claude in the web CLI) or the server's mcp token ...
QCLI_TOKEN=qcli_pat_...
# ... or a user name and password (not both)
# QCLI_USER=ops
# QCLI_PASSWORD=change-me

# QCLI_READ_ONLY=false
# QCLI_TOOLS=fs_*,server_info
# QCLI_EXCLUDE=fs_delete
# QCLI_CONNECTION_TIMEOUT=8000
# QCLI_REQUEST_TIMEOUT=60000
# QCLI_TRUST_CERT=false

# QCLI_DEV_TOOLS=true
# QCLI_DOCS_URL=https://cli.qodalis.com/llms-full.txt
